# Server settings only. Use real values in an untracked .env or server environment.
POLICYIQ_ENV=development
POLICYIQ_ORIGIN=http://127.0.0.1:5173
# Optional absolute private storage directory; default is ~/.policyiq
# POLICYIQ_DATA_DIR=C:/path/to/private/policyiq-data
POLICYIQ_ENABLE_QUESTIONS=false
AI_PROVIDER=ollama
# Required for independent verification when questions are enabled:
OPENROUTER_API_KEY=replace-with-your-server-only-key
# Required if AI_PROVIDER=gemini or auto:
GEMINI_API_KEY=replace-with-your-server-only-key
# No backend secrets belong in frontend/.env or VITE_* values.
